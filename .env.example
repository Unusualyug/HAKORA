# ── Runtime ─────────────────────────────────────────────
NODE_ENV=production

# ── Database (Render internal connection string in prod) ─
DATABASE_URL=postgresql://user:password@host:5432/campussaathi

# ── Auth ────────────────────────────────────────────────
# 32+ random bytes, e.g. `openssl rand -hex 32`
AUTH_SECRET=

# First administrator - created/updated by `prisma db seed`
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com
BUSINESS_NAME=HAKORA
BUSINESS_WHATSAPP=919825751614

# ── Object storage (S3-compatible, e.g. Cloudflare R2) ──
# When all STORAGE_* vars are set, uploads go to private object
# storage and downloads use short-lived signed URLs.
# When unset, a local ./uploads directory is used (dev only -
# NOT suitable for Render's ephemeral filesystem).
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Analytics (optional) ────────────────────────────────
GOOGLE_ANALYTICS_ID=

# ── Local uploads fallback dir (dev only) ──────────────
UPLOAD_DIR=./uploads

# ── Razorpay payment gateway ───────────────────────────
# Server-side only. When unset, the student portal hides online
# payment and asks students to pay via WhatsApp/manual methods.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook endpoint: POST /api/payments/webhook (enable payment.captured & payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# ── Optional SMTP email notifications ──────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HAKORA <no-reply@example.com>"
