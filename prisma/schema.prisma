// CampusSaathi — Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum AdminRole {
  OWNER
  ADMIN
  STAFF
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTATION_SENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum OrderStatus {
  PENDING_CONFIRMATION
  QUOTATION_SENT
  CONFIRMED
  PAYMENT_PENDING
  PROCESSING
  PRINTING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  NOT_SCHEDULED
  SCHEDULED
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum PrintMode {
  BLACK_WHITE
  COLOR
  MIXED
}

enum PrintSides {
  SINGLE
  DOUBLE
}

enum BindingType {
  NONE
  SPIRAL
  HARD
  SOFT
  STAPLE
}

// ─────────────────────────── Models ───────────────────────────

model AdminUser {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           AdminRole @default(ADMIN)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notes        EnquiryNote[]
  statusEvents EnquiryStatusHistory[]
  auditLogs    AuditLog[]

  @@index([email])
}

model Customer {
  id            String    @id @default(uuid())
  publicId      String    @unique // e.g. CU-0001
  fullName      String
  mobile        String    @unique
  college       String?
  department    String?
  email         String?
  isRegular     Boolean   @default(false)
  notes         String?
  firstEnquiry  DateTime  @default(now())
  lastActivity  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enquiries  Enquiry[]
  orders     Order[]
  reviews    Review[]
  quotations Quotation[]

  @@index([mobile])
  @@index([fullName])
  @@index([college])
}

model Enquiry {
  id              String        @id @default(uuid())
  refNo           String        @unique // CS-2026-0001
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  serviceId       String?
  service         Service?      @relation(fields: [serviceId], references: [id])
  serviceCategory String?
  description     String
  course          String?
  semester        String?
  quantity        String?
  deadline        DateTime?
  needsDelivery   Boolean       @default(false)
  deliveryAddress String?
  status          EnquiryStatus @default(NEW)
  quotationAmount Decimal?      @db.Decimal(10, 2)
  quotationNotes  String?
  consentGiven    Boolean       @default(false)
  archived        Boolean       @default(false)
  source          String?       // landing page / utm source
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  attachments   EnquiryAttachment[]
  notesList     EnquiryNote[]
  statusHistory EnquiryStatusHistory[]
  orders        Order[]
  quotations    Quotation[]

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([archived])
}

model EnquiryAttachment {
  id          String   @id @default(uuid())
  enquiryId   String
  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fileName    String
  storedKey   String   @unique
  mimeType    String
  sizeBytes   Int
  storage     String   @default("local") // local | s3
  uploadedBy  String   @default("student") // student | admin
  createdAt   DateTime @default(now())

  @@index([enquiryId])
  @@index([createdAt])
}

model EnquiryNote {
  id        String    @id @default(uuid())
  enquiryId String
  enquiry   Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime  @default(now())

  @@index([enquiryId])
}

model EnquiryStatusHistory {
  id         String        @id @default(uuid())
  enquiryId  String
  enquiry    Enquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromStatus EnquiryStatus?
  toStatus   EnquiryStatus
  adminId    String?
  admin      AdminUser?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  note       String?
  createdAt  DateTime      @default(now())

  @@index([enquiryId])
}

model Order {
  id                 String      @id @default(uuid())
  orderNo            String      @unique // CSO-2026-0001
  customerId         String
  customer           Customer    @relation(fields: [customerId], references: [id])
  enquiryId          String?
  enquiry            Enquiry?    @relation(fields: [enquiryId], references: [id])
  title              String
  description        String?
  serviceType        String?
  status             OrderStatus @default(PENDING_CONFIRMATION)
  quantity           Int         @default(1)
  pages              Int?
  unitPrice          Decimal     @default(0) @db.Decimal(10, 2)
  additionalCharges  Decimal     @default(0) @db.Decimal(10, 2)
  deliveryCharges    Decimal     @default(0) @db.Decimal(10, 2)
  discount           Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal     @default(0) @db.Decimal(10, 2)
  advancePaid        Decimal     @default(0) @db.Decimal(10, 2)
  expectedCompletion DateTime?
  internalNotes      String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items     OrderItem[]
  payments  Payment[]
  quotation Quotation?
  printSpec PrintingSpecification?
  delivery  Delivery?

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0) @db.Decimal(10, 2)
  lineTotal   Decimal @default(0) @db.Decimal(10, 2)

  @@index([orderId])
}

model Payment {
  id               String         @id @default(uuid())
  orderId          String?
  order            Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quotationId      String?
  quotation        Quotation?     @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  customerId       String?
  amount           Decimal        @db.Decimal(10, 2)
  method           PaymentMethod  @default(CASH)
  gateway          PaymentGateway @default(MANUAL)
  gatewayMethod    String?        // upi / card / netbanking / wallet (from gateway)
  status           PaymentStatus  @default(SUCCESS)
  gatewayOrderId   String?        @unique
  gatewayPaymentId String?        @unique
  reference        String?
  refundedAmount   Decimal        @default(0) @db.Decimal(10, 2)
  failureReason    String?
  paidAt           DateTime       @default(now())
  notes            String?
  createdAt        DateTime       @default(now())

  refunds Refund[]
  invoice Invoice?

  @@index([orderId])
  @@index([quotationId])
  @@index([status])
  @@index([paidAt])
}

model PrintingSpecification {
  id            String      @id @default(uuid())
  orderId       String      @unique
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  documents     Int         @default(1)
  pagesPerDoc   Int         @default(1)
  totalPages    Int         @default(1)
  copies        Int         @default(1)
  printMode     PrintMode   @default(BLACK_WHITE)
  sides         PrintSides  @default(SINGLE)
  bindingType   BindingType @default(NONE)
  paperSize     String      @default("A4")
  paperQuality  String      @default("70 GSM")
  printingPrice Decimal     @default(0) @db.Decimal(10, 2)
  bindingPrice  Decimal     @default(0) @db.Decimal(10, 2)
  deliveryPrice Decimal     @default(0) @db.Decimal(10, 2)
  quotedTotal   Decimal     @default(0) @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Delivery {
  id           String         @id @default(uuid())
  orderId      String         @unique
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  contactName  String
  mobile       String
  address      String
  landmark     String?
  area         String?
  fee          Decimal        @default(0) @db.Decimal(10, 2)
  expectedDate DateTime?
  status       DeliveryStatus @default(NOT_SCHEDULED)
  notes        String?
  deliveredAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([expectedDate])
}

model Service {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  shortDesc     String
  longDesc      String?
  icon          String   @default("FileText") // lucide icon name
  startingPrice Decimal? @db.Decimal(10, 2)
  priceUnit     String?  // e.g. "per page", "per copy"
  displayOrder  Int      @default(0)
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enquiries Enquiry[]

  @@index([isActive, displayOrder])
}

model PricingRule {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. bw_single_per_page
  label     String
  unit      String   // per page / per copy / flat
  price     Decimal  @db.Decimal(10, 2)
  category  String   @default("printing") // printing | binding | delivery
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model WebsiteSettings {
  id        String   @id @default("singleton")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model Review {
  id           String       @id @default(uuid())
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName   String
  college      String?
  rating       Int          @default(5)
  body         String
  status       ReviewStatus @default(PENDING)
  isFeatured   Boolean      @default(false)
  source       String       @default("admin") // admin | website
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, isFeatured])
}

model AnonymousSession {
  id           String   @id // random token generated client-side cookie
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  landingPage  String?
  referrer     String?
  utmSource    String?
  deviceType   String?  // mobile | tablet | desktop
  browser      String?
  country      String?
  consent      Boolean  @default(false)

  events AnalyticsEvent[]

  @@index([firstSeenAt])
}

model AnalyticsEvent {
  id        String            @id @default(uuid())
  sessionId String?
  session   AnonymousSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  type      String            // page_view | service_click | form_start | form_submit | whatsapp_click | bulk_whatsapp_click
  path      String?
  meta      Json?
  createdAt DateTime          @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // new_enquiry | status_change | system
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model AuditLog {
  id        String     @id @default(uuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model Counter {
  key   String @id // e.g. enquiry-2026, order-2026, customer
  value Int    @default(0)
}

// ─────────────── Quotation & Online Payment models ───────────────

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
  SUPERSEDED
}

enum QuotationItemKind {
  SERVICE
  PRINTING
  BINDING
  DELIVERY
  OTHER
}

enum AdvanceType {
  FULL
  PERCENT
  FIXED
}

enum PaymentGateway {
  MANUAL
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model Quotation {
  id            String          @id @default(uuid())
  quoteNo       String          @unique // HQ-2026-0001
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id])
  enquiryId     String?
  enquiry       Enquiry?        @relation(fields: [enquiryId], references: [id])
  orderId       String?         @unique // order created after payment/acceptance
  order         Order?          @relation(fields: [orderId], references: [id])
  status        QuotationStatus @default(DRAFT)
  title         String
  notes         String?
  paymentTerms  String?
  validUntil    DateTime?
  taxLabel      String          @default("GST")
  taxRate       Decimal         @default(0) @db.Decimal(5, 2) // percent
  discount      Decimal         @default(0) @db.Decimal(10, 2)
  subtotal      Decimal         @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal         @default(0) @db.Decimal(10, 2)
  total         Decimal         @default(0) @db.Decimal(10, 2)
  advanceType   AdvanceType     @default(FULL)
  advanceValue  Decimal         @default(0) @db.Decimal(10, 2) // percent or fixed amount
  advanceAmount Decimal         @default(0) @db.Decimal(10, 2) // computed required payment
  tokenHash     String?         @unique // sha256 of portal access token
  revisionNo    Int             @default(1)
  sentAt        DateTime?
  viewedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items      QuotationItem[]
  revisions  QuotationRevision[]
  acceptance QuotationAcceptance?
  payments   Payment[]
  invoices   Invoice[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model QuotationItem {
  id          String            @id @default(uuid())
  quotationId String
  quotation   Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  kind        QuotationItemKind @default(SERVICE)
  description String
  quantity    Decimal           @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal           @default(0) @db.Decimal(10, 2)
  lineTotal   Decimal           @default(0) @db.Decimal(10, 2)
  sortOrder   Int               @default(0)

  @@index([quotationId])
}

model QuotationRevision {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revisionNo  Int
  snapshot    Json
  reason      String?
  adminId     String?
  createdAt   DateTime  @default(now())

  @@unique([quotationId, revisionNo])
}

model QuotationAcceptance {
  id          String    @id @default(uuid())
  quotationId String    @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  acceptedAt  DateTime  @default(now())
  acceptorIp  String?
  userAgent   String?
}

model PaymentWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique // gateway event id — idempotency key
  type        String
  payload     Json
  status      String   @default("processed") // processed | skipped | error
  error       String?
  createdAt   DateTime @default(now())
}

model Invoice {
  id          String     @id @default(uuid())
  invoiceNo   String     @unique // HINV-2026-0001
  customerId  String
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])
  orderId     String?
  paymentId   String?    @unique
  payment     Payment?   @relation(fields: [paymentId], references: [id])
  amount      Decimal    @db.Decimal(10, 2)
  data        Json // snapshot of lines/totals at issue time
  issuedAt    DateTime   @default(now())

  @@index([customerId])
}

model Refund {
  id              String       @id @default(uuid())
  paymentId       String
  payment         Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount          Decimal      @db.Decimal(10, 2)
  gatewayRefundId String?      @unique
  status          RefundStatus @default(PROCESSED)
  reason          String?
  createdAt       DateTime     @default(now())

  @@index([paymentId])
}
